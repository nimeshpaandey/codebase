# ==========================================
# CodeSentinel Environment Configuration
# ==========================================

# Google Gemini API Key (Optional)
# If left blank, CodeSentinel automatically falls back to its local AI semantic analyzer
GOOGLE_API_KEY=

# LLM Provider selection: "auto", "gemini", or "mock"
LLM_PROVIDER=auto

# Model to use when LLM_PROVIDER is "gemini"
LLM_MODEL=gemini-1.5-flash

# GitHub Webhook HMAC Secret for signature verification
GITHUB_WEBHOOK_SECRET=dummy_secret_for_local_test

# SQLite Database Path
DATABASE_PATH=data/codesentinel.db
